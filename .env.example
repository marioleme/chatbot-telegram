# Copie para .env e substitua os valores de exemplo. Nunca publique o .env.
# stable acompanha atualizacoes; para reproducibilidade, fixe a versao do seu n8n.
N8N_VERSION=stable
N8N_LOCAL_PORT=5680
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5680
# URL HTTPS de um proxy/tunel que encaminhe para localhost:5680.
# O endereco abaixo e ilustrativo: nao encaminha mensagens.
WEBHOOK_URL=https://seu-n8n.example.com/
N8N_PROXY_HOPS=1
OPENWEATHER_API_KEY=SUBSTITUA_PELA_SUA_CHAVE
# Gere uma chave aleatoria de 32 bytes ou mais. Guarde-a junto com o backup.
N8N_ENCRYPTION_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA
# Valores abaixo sao lembretes; nao sao enviados ao container nem criam credenciais.
# Insira-os manualmente nas credenciais n8n depois de importar o workflow.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
